---
import CodeShowcase from "../components/CodeShowcase";
import ThemeControl from "../components/ThemeControl";
import "../styles/global.css";

interface Props {
  locale: "en" | "ko";
}

const { locale } = Astro.props;
const isKorean = locale === "ko";
const canonicalUrl = isKorean
  ? "https://typenn.typeshade.dev/ko/"
  : "https://typenn.typeshade.dev/";
const t = isKorean
  ? {
      title: "TypeNN — TypeScript 신경망 프레임워크",
      description: "TypeNN은 지연 Tensor 그래프를 TypeShade 커널로 실행하는 TypeScript 신경망 프레임워크입니다.",
      nav: ["실행 방식", "학습", "구현 범위"],
      language: "English",
      dark: "어두운 테마",
      light: "밝은 테마",
      heroTitle: "TypeNN은 Tensor 그래프를 만듭니다. TypeShade는 컴파일된 커널을 실행합니다.",
      heroBody: "TypeScript Tensor와 Module API로 신경망 연산을 정의합니다. TypeNN은 지연 그래프를 만들고 지원 연산을 TypeShade 프로그램으로 실행합니다.",
      source: "GitHub 저장소",
      mnist: "MNIST 학습 예제",
      showcase: {
        title: "TypeNN API에서 커널 실행까지",
        operation: "연산과 커널",
        trainingTab: "학습 루프",
        tensor: "Tensor API",
        kernel: "실제 TypeShade 커널",
        training: "MNIST 학습 코드",
        tensorFile: "README.md",
        kernelFile: "src/kernels/relu.shade.ts",
        trainingFile: "README.md · PyTorch-style model training",
        copy: "코드 복사",
        copied: "복사됨",
        copyFailed: "복사 실패",
        output: "README 결과",
        operationOutput: "Float32Array [19, 22, 43, 50]",
        compileNote: "커널 소스입니다. TypeShade가 패키지 빌드에서 컴파일한 출력 코드가 아닙니다.",
      },
      executionTitle: "Tensor 의미론과 셰이더 실행은 각 계층이 맡습니다.",
      executionBody: "Tensor 메서드는 지연 그래프 노드를 추가합니다. 값을 읽으면 해당 결과에 필요한 그래프가 실행됩니다. 내부 .shade.ts 커널은 패키지 빌드 중 TypeShade 프로그램으로 컴파일됩니다. GPU 실행은 커널 디스패치를 Frame에 기록하고 제출합니다.",
      executionLink: "Tensor API와 실행 코드 보기",
      stages: [
        { title: "Tensor 그래프", body: "Shape와 연산 의미, 모듈, 손실 함수, Tensor 그래프 기울기 규칙은 TypeNN이 관리합니다." },
        { title: "커널 컴파일", body: "각 내부 .shade.ts 연산 커널은 TypeShade 프로그램으로 컴파일됩니다. 여러 디스패치를 모은 Frame이 커널을 합치지는 않습니다." },
        { title: "장치 디스패치", body: "TypeShade Runtime은 CPU, WebGPU와 지원되는 WebGL2 경로에서 프로그램을 실행합니다. 자동 선택은 WebGPU를 시도한 뒤 CPU로 폴백합니다." },
      ],
      boundary: "GPU Frame 하나가 여러 커널 디스패치를 제출할 수 있습니다. 이는 커널 퓨전과 다릅니다. 그래프 전체 퓨전은 아직 구현되지 않았습니다.",
      trainingTitle: "GPU 학습에서 Adam 상태는 장치에 남습니다.",
      trainingBody: "WebGPU와 WebGL2에서는 지연 기울기 계산과 파라미터 갱신 커널을 TypeShade Frame에 기록합니다. Adam의 1·2차 모멘트는 Device 소유 Resident 버퍼에 유지됩니다. CPU 옵티마이저는 호스트 배열을 사용합니다.",
      trainingFacts: [
        { label: "기울기와 갱신", value: "GPU 커널로 실행" },
        { label: "Adam 모멘트", value: "Device Resident 버퍼" },
        { label: "CPU 폴백", value: "호스트 옵티마이저" },
      ],
      trainingLink: "GPU 학습 구현 상태",
      scopeTitle: "현재 구현 범위와 남은 작업",
      scopeIntro: "구현 상태는 저장소의 README와 TODO에서 확인할 수 있습니다.",
      implementedTitle: "구현된 API",
      limitTitle: "현재 한계",
      capabilities: [
        { title: "Tensor 연산", body: "rank-2 MatMul, 제한된 broadcasting, elementwise 연산, activation, reduction, softmax와 logits 기반 cross entropy를 제공합니다.", link: "연산 및 Shape 범위", href: "https://github.com/typeshade/typenn/blob/main/README.md#current-scope" },
        { title: "Module 학습", body: "Module, Sequential, Linear, Flatten, ReLU, Dropout과 CrossEntropyLoss로 MNIST MLP 학습 루프를 구성할 수 있습니다.", link: "MNIST 예제 소스", href: "https://github.com/typeshade/typenn/tree/main/examples/mnist" },
        { title: "Tensor 자동 미분", body: "역전파 규칙은 선택된 연산을 지원합니다. TypeShade shadeGrad는 순수 TypeShade 함수에 적용되는 별도 미분 API입니다.", link: "Autograd 구현", href: "https://github.com/typeshade/typenn/tree/main/src/autograd" },
      ],
      limits: [
        { title: "그래프 최적화", body: "연산 노드마다 커널을 디스패치합니다. Kernel fusion과 그래프 liveness 기반 버퍼 재사용은 구현되지 않았습니다." },
        { title: "MatMul", body: "출력 원소마다 하나의 invocation이 내적을 계산합니다. Workgroup tiling은 아직 없습니다." },
        { title: "Backend와 기울기", body: "WebGL2는 제한된 compute-lowering 경로입니다. Tensor 그래프 기울기 규칙과 활성 Device 수에도 제약이 있습니다." },
      ],
      validation: "WebGPU와 WebGL2 학습 경로는 Chromium의 SwiftShader 소프트웨어 렌더링으로 smoke test했습니다. 물리 GPU 성능 측정과 TensorFlow.js 비교는 아직 없습니다.",
      todoLink: "전체 구현 TODO",
      footer: "Tensor와 신경망 연산은 TypeNN이 정의합니다. TypeShade는 내부 커널을 컴파일하고 실행합니다.",
      footerLinks: ["TypeNN 저장소", "TypeShade 저장소", "구현 TODO", "사이트 소스"],
    }
  : {
      title: "TypeNN — Neural networks in TypeScript",
      description: "TypeNN builds deferred Tensor graphs and runs TypeShade-compiled kernels across CPU and supported GPU backends.",
      nav: ["Execution", "Training", "Current scope"],
      language: "한국어",
      dark: "Dark theme",
      light: "Light theme",
      heroTitle: "TypeNN builds Tensor graphs. TypeShade runs compiled kernels.",
      heroBody: "Define neural network operations with TypeScript Tensor and Module APIs. TypeNN builds a deferred graph and runs supported operations through TypeShade programs.",
      source: "TypeNN on GitHub",
      mnist: "Open the MNIST example",
      showcase: {
        title: "From Tensor API to kernel execution",
        operation: "Operation and kernel",
        trainingTab: "Training loop",
        tensor: "Tensor API",
        kernel: "Actual TypeShade kernel",
        training: "MNIST training code",
        tensorFile: "README.md",
        kernelFile: "src/kernels/relu.shade.ts",
        trainingFile: "README.md · PyTorch-style model training",
        copy: "Copy code",
        copied: "Copied",
        copyFailed: "Copy failed",
        output: "README output",
        operationOutput: "Float32Array [19, 22, 43, 50]",
        compileNote: "These are kernel sources. This view does not show generated TypeShade output.",
      },
      executionTitle: "Tensor semantics and shader execution have separate owners.",
      executionBody: "Tensor methods add nodes to a deferred graph. Reading a value executes the work needed for that result. Internal .shade.ts kernels compile to TypeShade programs during the package build. GPU execution records kernel dispatches in a Frame and submits it.",
      executionLink: "Read the Tensor API and execution code",
      stages: [
        { title: "Tensor graph", body: "TypeNN owns Shape and operation semantics, modules, loss functions, and Tensor graph gradient rules." },
        { title: "Kernel compilation", body: "Each internal .shade.ts operation kernel compiles to a TypeShade program. Grouping dispatches in a Frame does not merge kernels." },
        { title: "Device dispatch", body: "The TypeShade Runtime executes programs on CPU, WebGPU, and supported WebGL2 paths. Automatic selection tries WebGPU, then falls back to CPU." },
      ],
      boundary: "A GPU Frame can submit several kernel dispatches. That is distinct from kernel fusion. Graph-wide fusion is not implemented.",
      trainingTitle: "On GPU, Adam state stays on the device.",
      trainingBody: "For WebGPU and WebGL2, deferred gradient work and parameter update kernels are recorded in a TypeShade Frame. Adam's first and second moments stay in Device-owned Resident buffers. The CPU optimizer uses host arrays.",
      trainingFacts: [
        { label: "Gradients and updates", value: "GPU kernels" },
        { label: "Adam moments", value: "Device Resident buffers" },
        { label: "CPU fallback", value: "Host optimizer" },
      ],
      trainingLink: "GPU training implementation status",
      scopeTitle: "Current implementation and limits",
      scopeIntro: "Check the repository README and TODO for the current implementation status.",
      implementedTitle: "Implemented API",
      limitTitle: "Current limits",
      capabilities: [
        { title: "Tensor operations", body: "Includes rank-2 MatMul, limited broadcasting, elementwise operations, activations, reductions, softmax, and logits-based cross entropy.", link: "Operation and Shape scope", href: "https://github.com/typeshade/typenn/blob/main/README.md#current-scope" },
        { title: "Module training", body: "Module, Sequential, Linear, Flatten, ReLU, Dropout, and CrossEntropyLoss support the documented MNIST MLP loop.", link: "MNIST example source", href: "https://github.com/typeshade/typenn/tree/main/examples/mnist" },
        { title: "Tensor autograd", body: "Reverse-mode rules cover selected operations. TypeShade shadeGrad is a separate differentiation API for pure TypeShade functions.", link: "Autograd implementation", href: "https://github.com/typeshade/typenn/tree/main/src/autograd" },
      ],
      limits: [
        { title: "Graph optimization", body: "The executor dispatches a kernel per graph node. Kernel fusion and graph-wide liveness-based buffer reuse are not implemented." },
        { title: "MatMul", body: "One invocation computes each output element with a serial inner product. Workgroup tiling is not implemented." },
        { title: "Backends and gradients", body: "WebGL2 uses a constrained compute-lowering path. Tensor graph gradient coverage and active Device count are limited." },
      ],
      validation: "WebGPU and WebGL2 training paths have smoke coverage in Chromium with SwiftShader software rendering. Physical GPU performance and TensorFlow.js comparisons are unmeasured.",
      todoLink: "Full implementation TODO",
      footer: "TypeNN defines Tensor and neural network operations. TypeShade compiles and runs the internal kernels.",
      footerLinks: ["TypeNN repository", "TypeShade repository", "Implementation TODO", "Site source"],
    };

const sourceLinks = [
  "https://github.com/typeshade/typenn",
  "https://github.com/typeshade/typeshade",
  "https://github.com/typeshade/typenn/blob/main/TODO.md",
  "https://github.com/typeshade/typenn/tree/site/website-source/website",
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#f5f5f5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TypeNN" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={isKorean ? "ko_KR" : "en_US"} />
    <meta property="og:locale:alternate" content={isKorean ? "en_US" : "ko_KR"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="alternate" hreflang="en" href="https://typenn.typeshade.dev/" />
    <link rel="alternate" hreflang="ko" href="https://typenn.typeshade.dev/ko/" />
    <link rel="alternate" hreflang="x-default" href="https://typenn.typeshade.dev/" />
    <title>{t.title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("typenn-theme");
        const dark = saved === "dark" || (saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch {}
    </script>
  </head>
  <body class="bg-ground text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-panel focus:px-4 focus:py-2">
      {isKorean ? "본문으로 건너뛰기" : "Skip to content"}
    </a>
    <header class="sticky top-0 z-30 border-b border-line bg-ground/95 backdrop-blur-sm">
      <div class="mx-auto flex min-h-[68px] max-w-[1320px] items-center justify-between gap-4 px-4 sm:px-6">
        <a href={isKorean ? "/ko/" : "/"} class="inline-flex shrink-0 items-center gap-3" aria-label="TypeNN home">
          <img src="/mark.svg" width="30" height="30" alt="" />
          <span class="text-[17px] font-semibold tracking-[-0.03em]">TypeNN</span>
        </a>
        <nav aria-label={isKorean ? "주요 메뉴" : "Main navigation"} class="hidden items-center gap-7 text-sm text-muted md:flex">
          <a class="transition-colors hover:text-ink" href="#architecture">{t.nav[0]}</a>
          <a class="transition-colors hover:text-ink" href="#training">{t.nav[1]}</a>
          <a class="transition-colors hover:text-ink" href="#scope">{t.nav[2]}</a>
          <a class="transition-colors hover:text-ink" href="https://github.com/typeshade/typenn" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
        <div class="flex items-center gap-3">
          <a class="rounded-md px-2 py-1 text-sm font-medium text-brand hover:bg-soft" href={isKorean ? "/" : "/ko/"} lang={isKorean ? "en" : "ko"}>
            {t.language}
          </a>
          <ThemeControl client:load darkLabel={t.dark} lightLabel={t.light} />
        </div>
      </div>
      <nav aria-label={isKorean ? "섹션 메뉴" : "Section navigation"} class="mx-auto flex max-w-[1320px] gap-5 overflow-x-auto px-4 pb-3 text-xs text-muted sm:px-6 md:hidden">
        <a class="shrink-0 hover:text-ink" href="#architecture">{t.nav[0]}</a>
        <a class="shrink-0 hover:text-ink" href="#training">{t.nav[1]}</a>
        <a class="shrink-0 hover:text-ink" href="#scope">{t.nav[2]}</a>
        <a class="shrink-0 hover:text-ink" href="https://github.com/typeshade/typenn" target="_blank" rel="noreferrer">GitHub ↗</a>
      </nav>
    </header>

    <main id="main">
      <section class="mx-auto grid max-w-[1320px] items-center gap-10 px-4 pb-20 pt-14 sm:px-6 sm:pt-20 lg:grid-cols-[0.72fr_1.28fr] lg:gap-12 lg:pb-24 lg:pt-24">
        <div>
          <h1 class="max-w-[620px] text-[clamp(2.45rem,5.1vw,4.65rem)] font-semibold leading-[1.08] tracking-[-0.045em]">
            {t.heroTitle}
          </h1>
          <p class="mt-6 max-w-[550px] text-lg leading-[1.7] text-muted">{t.heroBody}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://github.com/typeshade/typenn" target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-brand px-5 text-sm font-semibold text-white transition-opacity hover:opacity-90">
              {t.source}<span aria-hidden="true">↗</span>
            </a>
            <a href="https://github.com/typeshade/typenn/tree/main/examples/mnist" target="_blank" rel="noreferrer" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border border-line bg-panel px-5 text-sm font-medium transition-colors hover:bg-soft">
              {t.mnist}<span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="mt-7 text-xs leading-6 text-muted">TypeScript <span aria-hidden="true">·</span> Tensor graph <span aria-hidden="true">·</span> TypeShade Runtime</p>
        </div>
        <CodeShowcase client:load labels={t.showcase} />
      </section>

      <section id="architecture" class="scroll-mt-24 border-y border-line bg-panel">
        <div class="mx-auto max-w-[1320px] px-4 py-18 sm:px-6 lg:py-24">
          <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
            <div>
              <h2 class="max-w-xl text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl">{t.executionTitle}</h2>
              <p class="mt-5 max-w-[560px] text-base leading-[1.8] text-muted">{t.executionBody}</p>
              <a class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline" href="https://github.com/typeshade/typenn#typenn" target="_blank" rel="noreferrer">{t.executionLink}<span aria-hidden="true">↗</span></a>
            </div>
            <div class="grid gap-6 md:grid-cols-3">
              {t.stages.map((stage) => (
                <article class="border-t border-line pt-4">
                  <h3 class="text-lg font-semibold tracking-[-0.02em]">{stage.title}</h3>
                  <p class="mt-3 text-sm leading-[1.75] text-muted">{stage.body}</p>
                </article>
              ))}
            </div>
          </div>
          <p class="mt-8 rounded-md bg-soft px-4 py-3 text-sm leading-7 text-muted">{t.boundary}</p>
        </div>
      </section>

      <section id="training" class="scroll-mt-24 mx-auto grid max-w-[1320px] gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:py-24">
        <div class="self-center">
          <h2 class="max-w-xl text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl">{t.trainingTitle}</h2>
          <p class="mt-5 max-w-[560px] text-base leading-[1.8] text-muted">{t.trainingBody}</p>
          <a class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline" href="https://github.com/typeshade/typenn/blob/main/TODO.md#compiler-first-execution-and-training-status-2026-10-11" target="_blank" rel="noreferrer">{t.trainingLink}<span aria-hidden="true">↗</span></a>
          <dl class="mt-8 grid divide-y divide-line border-y border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            {t.trainingFacts.map((fact) => (
              <div class="py-3 sm:px-3 sm:first:ps-0 sm:last:pe-0">
                <dt class="text-xs leading-5 text-muted">{fact.label}</dt>
                <dd class="mt-1 text-sm font-semibold leading-6">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="rounded-lg border border-line bg-panel p-5 sm:p-7">
          <h3 class="text-base font-semibold">{isKorean ? "학습 단계" : "Training path"}</h3>
          <ol class="mt-4 divide-y divide-line border-y border-line">
            {(isKorean
              ? ["Batch 입력에서 logits와 CrossEntropyLoss를 계산합니다.", "backward()가 등록된 파라미터의 기울기를 누적합니다.", "optimizer.step()이 선택된 백엔드에서 파라미터를 갱신합니다.", "disposeGraph()가 파라미터를 보존하며 연산 그래프를 해제합니다."]
              : ["Compute logits and CrossEntropyLoss from a batch.", "backward() accumulates gradients for registered parameters.", "optimizer.step() updates parameters on the selected backend.", "disposeGraph() releases the operation graph and preserves parameters."]
            ).map((step, index) => (
              <li class="flex items-start gap-4 py-3">
                <span class="w-6 shrink-0 font-mono text-xs text-muted">0{index + 1}</span>
                <span class="text-sm leading-6">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="scope" class="scroll-mt-24 border-y border-line bg-panel">
        <div class="mx-auto max-w-[1320px] px-4 py-20 sm:px-6 lg:py-24">
          <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
            <div>
              <h2 class="max-w-xl text-3xl font-semibold leading-tight tracking-[-0.035em] sm:text-4xl">{t.scopeTitle}</h2>
              <p class="mt-5 max-w-[460px] text-base leading-[1.8] text-muted">{t.scopeIntro}</p>
              <a class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline" href="https://github.com/typeshade/typenn/blob/main/TODO.md" target="_blank" rel="noreferrer">{t.todoLink}<span aria-hidden="true">↗</span></a>
            </div>
            <div class="grid gap-10 md:grid-cols-2">
              <section aria-labelledby="implemented-title">
                <h3 id="implemented-title" class="border-b border-line pb-3 text-base font-semibold">{t.implementedTitle}</h3>
                <ul class="divide-y divide-line">
                  {t.capabilities.map((item) => (
                    <li class="py-4">
                      <h4 class="text-sm font-semibold">{item.title}</h4>
                      <p class="mt-2 text-sm leading-[1.75] text-muted">{item.body}</p>
                      <a class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline" href={item.href} target="_blank" rel="noreferrer">{item.link}<span aria-hidden="true">↗</span></a>
                    </li>
                  ))}
                </ul>
              </section>
              <section aria-labelledby="limits-title">
                <h3 id="limits-title" class="border-b border-line pb-3 text-base font-semibold">{t.limitTitle}</h3>
                <ul class="divide-y divide-line">
                  {t.limits.map((item) => (
                    <li class="py-4">
                      <h4 class="text-sm font-semibold">{item.title}</h4>
                      <p class="mt-2 text-sm leading-[1.75] text-muted">{item.body}</p>
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          </div>
          <p class="mt-9 max-w-[900px] border-t border-line pt-5 text-xs leading-6 text-muted">{t.validation}</p>
        </div>
      </section>
    </main>

    <footer class="mx-auto max-w-[1320px] px-4 py-9 sm:px-6">
      <div class="flex flex-col gap-5 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <img src="/mark.svg" width="24" height="24" alt="" />
          <p class="max-w-xl text-xs leading-6 text-muted">{t.footer}</p>
        </div>
        <nav aria-label={isKorean ? "프로젝트 링크" : "Project links"} class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted">
          {t.footerLinks.map((link, index) => <a class="hover:text-brand" href={sourceLinks[index]} target="_blank" rel="noreferrer">{link}<span aria-hidden="true"> ↗</span></a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
