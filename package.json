{
  "name": "typenn",
  "version": "0.0.0",
  "description": "A TypeScript neural network library powered by TypeShade.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typeshade": "https://github.com/typeshade/typeshade/archive/be90a216d2900a24ffd4bb915b070ac74cc36028.tar.gz",
    "vite": "^6.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:gpu": "npm run build && node --test tests/gpu/*.test.mjs",
    "test:gpu:sampling": "npm run build && node --test tests/gpu/sampling.gpu.test.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeshade/typenn.git"
  },
  "homepage": "https://github.com/typeshade/typenn#readme",
  "bugs": {
    "url": "https://github.com/typeshade/typenn/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
