{
  "name": "typenn",
  "version": "0.0.0",
  "description": "A TypeScript neural network library powered by TypeShade.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typeshade": "https://github.com/typeshade/typeshade/archive/946b0ea7640a397fff53c4481dbf6d26c254d8af.tar.gz",
    "vite": "^6.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node scripts/verify-elementwise-fusion.mjs",
    "build:elementwise-fusion:browser": "node scripts/build-elementwise-fusion-browser.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeshade/typenn.git"
  },
  "homepage": "https://github.com/typeshade/typenn#readme",
  "bugs": {
    "url": "https://github.com/typeshade/typenn/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
