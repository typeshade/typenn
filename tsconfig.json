{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "moduleSuffixes": [".typeshade", ""],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.shade.ts"]
}
